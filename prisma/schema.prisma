generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Customer {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  imageUrl String? @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  invoices invoices[]

  @@map("customers")
}
  enum InvoicesStatus {
    PENDING
    PAID
  }

  model invoices {
    id Int @id @default(autoincrement())
    amount Int
    stutus InvoicesStatus
    customerId Int @map("customer_id")
    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    @@map("invoices")
  }
